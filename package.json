{
  "name": "arka-odalar",
  "version": "1.0.0",
  "description": "Arka Odalar: karanlık bir Backrooms bulmaca oyunu",
  "main": "main.js",
  "author": "Arka Odalar",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.arkaodalar.game",
    "productName": "Arka Odalar",
    "files": [
      "main.js",
      "index.html",
      "node_modules/three/build/three.min.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "mac": {
      "category": "public.app-category.games"
    }
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs"
}
